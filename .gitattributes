# Large binary art sources go through Git LFS (`git lfs install` once per machine).
# Compressed game models in apps/client/public/models stay in plain git.
*.blend  filter=lfs diff=lfs merge=lfs -text
*.blend1 filter=lfs diff=lfs merge=lfs -text
*.psd    filter=lfs diff=lfs merge=lfs -text
*.kra    filter=lfs diff=lfs merge=lfs -text
*.fbx    filter=lfs diff=lfs merge=lfs -text
art/**/*.wav filter=lfs diff=lfs merge=lfs -text
art/**/*.png filter=lfs diff=lfs merge=lfs -text
